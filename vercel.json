{
  "functions": {
    "api/padron.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*\\.csv)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
